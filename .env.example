# Copy to .env (server.js loads it at startup; real environment variables win). Every value below is the default or empty.
# Never commit .env.

# ---- server ----
# Port the office listens on. Hooks (npm run install-hooks) must use the same port.
PORT=3001
# Where chats, wallet ledger, settings and the API token live. Empty = ./data (a source clone) or a per-user app-data folder (a copy that is not a clone).
DATA_DIR=
# Name shown in the page and the terminal (40 characters at most).
OFFICE_NAME=Box Office
# Fixed API token (16-128 chars of A-Z a-z 0-9 _ -). Empty = a random one is created once in <DATA_DIR>/.office-token.
OFFICE_TOKEN=
# 1 = /hook calls must carry the X-Office-Token header (install with: node tools/install-hooks.js --token-env or --token-file).
OFFICE_HOOK_TOKEN_REQUIRED=
# 1 = log hook event metadata (no prompts or replies) to <DATA_DIR>/hook-debug.jsonl.
OFFICE_HOOK_DEBUG=
# 1 = offer the "bypassPermissions" mode when hiring chats (off by default: such a chat never asks anything).
OFFICE_ALLOW_BYPASS=
# 1 = never offer "bypassPermissions", even with OFFICE_ALLOW_BYPASS=1.
OFFICE_DISABLE_BYPASS=
# Time limit for one Coordinator regex match, in ms (default 150). A pattern that runs longer is blacklisted and its
# deny/ask rule fails closed (counts as matched).
OFFICE_REGEX_TIMEOUT_MS=
# Total size cap for pasted images in <DATA_DIR>/uploads, in MB.
OFFICE_UPLOAD_QUOTA_MB=200

# ---- your Claude Code ----
# Claude Code's config dir (settings.json, projects/). Empty = ~/.claude. Same variable Claude Code itself reads.
CLAUDE_CONFIG_DIR=
# Transcript folder to read for tokens/spend. Empty = <config dir>/projects.
CLAUDE_PROJECTS_DIR=
# Full path of the claude executable, if it is not on PATH (imported and hired chats, the AI judge, Second opinion and the rule generator all run `claude`).
CLAUDE_BIN=
# Model used by the Second opinion button, and the model of the warm AI judge. Any alias or id your login can use.
ADVISOR_MODEL=fable
JUDGE_MODEL=haiku
# Optional plan-limit file (JSON {"t": epoch ms, "s": 5-hour %, "w": 7-day %}) that YOU keep fresh, e.g. from a Stop hook.
# Empty = <config dir>/usage-cache.json. Without the file (or when it is older than 3 hours) the "Plan limits" rule presets stay inert.
CLAUDE_USAGE_CACHE=

# ---- herdr (optional terminal manager) ----
# Nothing to set: if the `herdr` command is not on PATH the office is simply view-only (no typing into terminals).

# ---- economy (Beans and Gems) ----
# Wallet mode: Beans, Gems, streaks, shop prices, debt. ON by default (hats are always free). 0 = off (every cosmetic free, no economy UI), 1 = force on; wins over the saved setting.
OFFICE_WALLET=
# Folder for the signing key. Empty = %APPDATA%\claude-office (Windows) or $XDG_CONFIG_HOME/claude-office (~/.config/claude-office).
ECONOMY_KEY_DIR=
# 1 (Windows only) = keep the signing key in a plain file instead of Windows DPAPI.
ECONOMY_NO_DPAPI=
# Earnings start here: ISO date, e.g. 2026-01-01. Empty = the moment of first boot.
ECONOMY_CUTOFF=
# Scan period for new transcript lines, in ms.
ECONOMY_TICK_MS=20000
# A day counts as active from this many spendable tokens and prompts.
ECONOMY_ACTIVE_MIN_S2=1000000
ECONOMY_ACTIVE_MIN_PROMPTS=3
# Daily token amounts earning the full rate / half rate (above the second: nothing).
ECONOMY_BEAN_FULL_CAP=80000000
ECONOMY_BEAN_HALF_CAP=200000000
# Dev-only unlock passphrase for /api/economy/dev/unlock. Empty = that route does not exist.
OFFICE_DEV_PASSPHRASE=

# ---- AI judge tuning ----
# Recycle the warm process after this many calls / this many idle ms. 1 in JUDGE_DEBUG logs prompts to the console.
JUDGE_RECYCLE_AFTER=25
JUDGE_IDLE_MS=600000
JUDGE_DEBUG=

# ---- tests (not needed to run the office) ----
# tests/herdr-stub.js is used instead of the real herdr; the test runner sets this itself.
HERDR_STUB=
# Test-only clock and cap overrides.
ECONOMY_CLOCK_OFFSET_MS=
ECONOMY_ROOM_CAP_BASE=
ECONOMY_CUBE_CAP_BASE=
